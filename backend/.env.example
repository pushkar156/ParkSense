# ParkSense Backend Environment Configuration
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Arduino Serial Configuration
# Windows: COM3, COM4, etc. | Linux/macOS: /dev/ttyUSB0, /dev/ttyACM0
ARDUINO_PORT=COM3
ARDUINO_BAUD=9600

# SQLite Database
DB_PATH=parksense.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Simulation mode (true/false) - if true, runs simulation service even without hardware
SIMULATION_ENABLED=false
